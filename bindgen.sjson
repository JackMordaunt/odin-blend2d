inputs = [
	".headers"
]

remove = [
	// The version macro doesn't translate.
	"BL_VERSION"
]

type_overrides = {
	// BLRuntimeContext contains cpp fields that don't translate.
	"BLRuntimeContext" = "struct{}"
}

remove_type_prefix = "BL"
remove_function_prefix = "bl_"
remove_macro_prefix = "BL_"

output_folder = "binding"
package_name = "blend2d"

imports_file = "imports.inc"
